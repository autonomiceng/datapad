#!/usr/bin/env bash
#MISE description="Test explicit-file formatting safeguards"
#MISE depends=["deps:install"]
set -euo pipefail

format_task="$PWD/.mise/tasks/format"
formatter="$PWD/node_modules/.bin/vp"
format_config="$PWD/vite.config.ts"
# Vite+ requires inputs inside the workspace; keep fixtures outside ignored paths.
fixture_dir="$(mktemp -d "$PWD/.format-test.XXXXXXXX")"
trap 'rm -rf -- "$fixture_dir"' EXIT
cd "$fixture_dir"

printf '{"value":1}\n' > 'selected file.json'
cp 'selected file.json' selected.before
printf '{"value":2}\n' > untouched.json
cp untouched.json untouched.before
bash "$format_task" 'selected file.json'
if cmp -s 'selected file.json' selected.before; then
  echo 'FAIL: the selected file was not formatted.' >&2
  exit 1
fi
"$formatter" fmt --config "$format_config" --check 'selected file.json'
cmp untouched.json untouched.before
echo 'PASS: explicit filenames, including spaces, format without changing other files.'

for invalid in . '*.json' --write ../outside.json; do
  if bash "$format_task" "$invalid" >/dev/null 2>&1; then
    echo "FAIL: accepted unsafe formatting argument: $invalid" >&2
    exit 1
  fi
done
if bash "$format_task" >/dev/null 2>&1; then
  echo 'FAIL: accepted formatting without filenames.' >&2
  exit 1
fi
echo 'PASS: broad formatting and option arguments are rejected.'

if bash "$format_task" untouched.json missing.json >/dev/null 2>&1; then
  echo 'FAIL: accepted a missing file.' >&2
  exit 1
fi
cmp untouched.json untouched.before
echo 'PASS: an invalid file prevents writes to every requested file.'
