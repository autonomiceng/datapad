        "invoice_total": {
          "name": "invoice_total",
          "value": "\"invoices\".\"total_minor\" BETWEEN 50 AND 99999999"
        },
        "invoice_readiness": {
          "name": "invoice_readiness",
          "value": "\"invoices\".\"readiness_date\" = \"invoices\".\"due_date\" - 21"
        },
        "invoice_dates": {
          "name": "invoice_dates",
          "value": "\"invoices\".\"issue_date\" >= \"invoices\".\"readiness_date\" AND \"invoices\".\"issue_date\" < \"invoices\".\"due_date\""
        },
        "invoice_state": {
          "name": "invoice_state",
          "value": "\"invoices\".\"state\" IN ('requested', 'preparing', 'needs_review', 'draft', 'open', 'paid', 'void', 'uncollectible')"
        },
        "invoice_provider_status": {
          "name": "invoice_provider_status",
          "value": "\"invoices\".\"provider_status\" IS NULL OR \"invoices\".\"provider_status\" IN ('draft', 'open', 'paid', 'void', 'uncollectible')"
        },
        "invoice_review_reason": {
          "name": "invoice_review_reason",
          "value": "(\"invoices\".\"state\" = 'needs_review') = (\"invoices\".\"review_reason\" IS NOT NULL)"
        },
        "invoice_attempts": {
          "name": "invoice_attempts",
          "value": "\"invoices\".\"attempts\" >= 0"
        }
      },
      "isRLSEnabled": false
    },
