# Example for a PostgreSQL instance you manage locally.
# demo/dev derive their own database URL and ports; no .env copy is required.
DATABASE_URL=postgres://app:app@127.0.0.1:5432/app
HOST=127.0.0.1
PORT=3000
NODE_ENV=development

# Set this when serving the built SPA directly with Bun.
ASSETS_DIR=dist
